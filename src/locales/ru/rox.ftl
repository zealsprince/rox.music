## Сам сайт

# Заголовок для поиска, а не фраза для людей. «Если бы Foobar2000 сделали в
# текущем году» звучит лучше и остаётся в h1 и на социальной карточке, где её
# читает человек. В Google такое не набирают.
#
# Целимся в «foobar2000 alternative», единственный запрос, который rox
# действительно может выиграть. «linux music player» против двадцати лет
# подборок не берётся, а погоня за ним стоила бы того слова, которое приводит
# людей. В английском 59 знаков, чтобы Google показал заголовок целиком; тот же
# бюджет и здесь. Убрать одну платформу — самый дешёвый способ выиграть место.
site-tagline = rox - альтернатива Foobar2000 для Linux, macOS и Windows

# Меньше 160 знаков, иначе Google обрежет фразу на середине. Платформы уже
# стоят в заголовке, и это освобождает место под то, чего заголовок сказать не
# может.
site-description = Нативный плеер для больших локальных коллекций с аккуратными тегами. Собирайте свои панели, раздавайте темы файлом, держите скорость на 50 000 треков.

# Все четыре социальные карточки в static/social/ для каждого языка одни и те
# же, и фраза набрана внутри самой картинки по-английски. Значит, alt должен
# говорить, что там написано на самом деле, и что это английский. То же
# относится к download-title, workspaces-title и viz-title.
social-image-alt = Логотип rox над английской фразой: if Foobar2000 was made in the current year

# Число готовых рабочих пространств, прописью. Цифра меньше десяти посреди
# фразы читается как строка из спецификации, а какие числа писать прописью,
# каждый язык решает сам, поэтому это живёт здесь. Каждая фраза, где счёт
# упоминается, говорит { workspace-count } и прокидывает $count.
workspace-count = { $count ->
    [1] одно
    [2] два
    [3] три
    [4] четыре
    [5] пять
    [6] шесть
    [7] семь
    [8] восемь
    [9] девять
   *[other] { $count }
}

