## Сам сайт

# Заголовок для пошуку, а не фраза для людей. Ціль - запит «foobar2000
# alternative», який rox справді може виграти. В англійській 59 символів, щоб
# Google показав його цілком; тут той самий бюджет. Найдешевший спосіб
# звільнити місце - прибрати назву однієї платформи.
site-tagline = rox - альтернатива Foobar2000 для Linux, macOS і Windows

# Менше ніж 160 символів, інакше Google обріже опис посеред речення.
site-description = Нативний програвач для великих, дбайливо протегованих локальних медіатек. Складайте власні панелі, роздавайте теми файлом, тримайте швидкість на 50 000 треках.

# Усі чотири соціальні картки в static/social/ - це один файл на сторінку для
# всіх мов, і фраза намальована в самій картинці англійським текстом. Тому
# альтернативний текст каже, що там написано насправді, і що це англійська.
# Те саме стосується download-title, workspaces-title і viz-title.
social-image-alt = Логотип rox над англійською фразою: if Foobar2000 was made in the current year

# Кількість готових робочих просторів, словами. Цифра до десяти посеред
# речення читається як специфікація, а які числа писати словами - вирішує
# кожна мова сама. Кожне речення, що згадує кількість, каже
# { workspace-count } і передає далі $count.
#
# Увага: українська має три форми множини, а ця вибірка їх не розрізняє. Тому
# в реченнях числівник не має стояти перед іменником: пишіть «робочі простори,
# усього { workspace-count }», а не «{ workspace-count } робочих просторів»,
# інакше на трьох чи чотирьох відмінок поламається.
workspace-count = { $count ->
    [1] один
    [2] два
    [3] три
    [4] чотири
    [5] п'ять
    [6] шість
    [7] сім
    [8] вісім
    [9] дев'ять
   *[other] { $count }
}

