{
  "name": "rox - a Foobar2000 alternative for Linux, macOS and Windows",
  "short_name": "rox",
  "description": "A native music player for large, carefully tagged local libraries. Compose your own panels, share themes as files, and stay fast at 50,000 tracks.",
  "start_url": "/",
